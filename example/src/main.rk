> std::io::net::SocketAddrV4
> rock_http::response::Response
> rock_http::server::Server

handle = request ->
    if request.target.as_str! == "/health"
    then Response::text 200, "ok"
    else Response::text 404, "not found"


print_err = err ->
    "Cannot bind address".println!
    "Error: ".println!
    // er.println!


main = ->
    address = SocketAddrV4::localhost 8080
    Server::bind address
        >>= (.serve handle)
        <!> print_err
    0
