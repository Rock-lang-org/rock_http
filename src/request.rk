// Owned HTTP request data.

> std::string::String
> std::clone::Clone
> std::control::Option
> std::collections::Vec

< enum Method
    Get
    Head
    Post
    Put
    Delete
    Options
    Patch
    Other String

< enum Version
    Http10
    Http11

< struct Header
    < name: String
    < value: String

impl Header
    new: &Str -> &Str -> Header
    new = name, value ->
        Header
            name: String::from name
            value: String::from value

ascii_lower: U8 -> U8
< ascii_lower = byte ->
    value = byte as I64
    if value >= 65 && value <= 90
        (value + 32) as U8
    else
        byte

ascii_eq_ignore_case: &Str -> &Str -> Bool
< ascii_eq_ignore_case = left, right ->
    left_bytes = left.as_bytes!
    right_bytes = right.as_bytes!
    len = left_bytes.len!
    if len != right_bytes.len!
        false
    else
        mut equal = true
        mut i = 0
        while equal && i < len
            equal = (ascii_lower left_bytes[i]) == (ascii_lower right_bytes[i])
            i = i + 1
        equal

< struct Request
    < method: Method
    < target: String
    < version: Version
    < headers: Vec Header
    < body: Vec U8

impl Request
    @header: &Str -> Option &Str
    @header = name ->
        mut i = 0
        while i < self.headers.len!
            header = &self.headers[i]
            if ascii_eq_ignore_case header.name.as_str!, name
                return Option::Some (header.value.as_str!)
            i = i + 1
        Option::None

    @is_head = ->
        match *(&self.method)
            Method::Head => true
            _ => false

    @headers_named: &Str -> Vec String
    @headers_named = name ->
        mut values: Vec String = Vec::new!
        mut i = 0
        while i < self.headers.len!
            header = &self.headers[i]
            if ascii_eq_ignore_case header.name.as_str!, name
                values.push header.value.clone!
            i = i + 1
        values
