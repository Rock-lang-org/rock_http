// HTTP protocol and serving failures.

// Use the defining module so 0.7.0 resolves the concrete From impl argument.
> std::io::traits::IoError
> std::concurrency::thread::ThreadError
> std::convert::From

< enum HttpError
    Io IoError
    Thread ThreadError
    ConnectionClosed
    InvalidRequestLine
    InvalidMethod
    InvalidTarget
    UnsupportedVersion
    InvalidHeader
    InvalidContentLength
    ConflictingContentLength
    UnsupportedTransferEncoding
    RequestLineTooLarge
    HeadersTooLarge
    TooManyHeaders
    BodyTooLarge
    InvalidStatus

impl From IoError for HttpError
    from = error -> HttpError::Io error

impl From ThreadError for HttpError
    from = error -> HttpError::Thread error
